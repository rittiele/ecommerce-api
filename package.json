{
  "name": "ecommerce-api",
  "version": "0.1.0",
  "description": "API REST de e-commerce para aprendizado de back-end e portfólio.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
